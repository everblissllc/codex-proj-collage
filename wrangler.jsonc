{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "affiliate-deal-card-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "browser": { "binding": "BROWSER" },
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "PRODUCT_JOBS", "queue": "affiliate-deal-card-jobs" }],
    "consumers": [{ "queue": "affiliate-deal-card-jobs", "max_batch_size": 1, "max_batch_timeout": 1 }]
  },
  "vars": {
    "AI_TEXT_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "AFFILIATE_DISCLOSURE": "#Ad"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
